    "\n",
    "\n",
    "def fill_ecotype_nearest(src_nc: str, dst_nc: str, nodata: int = EVT_NODATA, var: str = \"EVT\") -> int:\n",
    "    \"\"\"Copy the ecotype NetCDF replacing no-data pixels by the nearest valid ecotype.\n",
