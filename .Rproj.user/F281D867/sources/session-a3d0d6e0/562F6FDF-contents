    "    lat, lon = domain[\"LAT\"], domain[\"LON\"]\n",
    "    lai = np.nan_to_num(np.asarray(met[\"lai\"], dtype=np.float64), nan=0.0, posinf=0.0, neginf=0.0)\n",
