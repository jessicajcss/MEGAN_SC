    "            par_f.append(mm_['par'])\n",
    "        D_PPFD = np.mean(par_f, axis=0) * fixes.PAR_WM2_TO_PPFD                                 # FIX-2\n",
    "        for i in idx_day:\n",
    "            if i in done:\n",
    "                continue\n",
